[Desktop Entry]
Type=Application
Version=1.5
Name=M5 Imager
Name[zh_CN]=M5 Imager
Comment=Tool for writing OS images for M5 devices
Comment[zh_CN]=用于将系统镜像写入 M5 设备启动介质的工具
Icon=rpi-imager
Exec=/usr/bin/rpi-imager %u
Categories=Utility;
StartupNotify=false
MimeType=x-scheme-handler/rpi-imager;application/vnd.raspberrypi.imager-manifest+json;
